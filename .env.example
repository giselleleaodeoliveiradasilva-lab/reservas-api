# Copie para .env e ajuste. Variáveis já definidas no ambiente têm prioridade sobre o .env.

DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL ---
DB_ENGINE=postgresql
DB_NAME=reservas
DB_USER=reservas
DB_PASSWORD=reservas
DB_HOST=127.0.0.1
DB_PORT=5432

